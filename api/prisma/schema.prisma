generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  INVENTORY_MANAGER
  PROCUREMENT_MANAGER
  FULFILLMENT_STAFF
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  PURCHASE_IN
  SHIPMENT_OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  RETURN_IN
  REVERSAL
}

enum ReservationStatus {
  ACTIVE
  PARTIALLY_CONSUMED
  CONSUMED
  RELEASED
  EXPIRED
}

enum InventoryAdjustmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

enum WarehouseTransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  RESERVED
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  DRAFT
  READY
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  COMPLETED
  CANCELLED
}

enum InspectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  PARTIALLY_ACCEPTED
}

enum ReturnDisposition {
  RESTOCK
  DAMAGED
  DISPOSE
  REPAIR
}

enum IdempotencyScope {
  CREATE_SALES_ORDER
  CREATE_PURCHASE_ORDER
  CREATE_PAYMENT
  CREATE_REFUND
  INVENTORY_ADJUSTMENT
  WAREHOUSE_TRANSFER
  OTHER
}

enum IdempotencyRecordStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum IdempotentResourceType {
  SALES_ORDER
  PURCHASE_ORDER
  PAYMENT
  REFUND
  INVENTORY_ADJUSTMENT
  WAREHOUSE_TRANSFER
  OTHER
}

model User {
  id                     String                @id @default(cuid())
  email                  String                @unique
  passwordHash           String
  firstName              String
  lastName               String
  role                   UserRole              @default(FULFILLMENT_STAFF)
  status                 UserStatus            @default(ACTIVE)
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)
  createdStockMovements  StockMovement[]       @relation("StockMovementCreatedBy")
  createdAdjustments     InventoryAdjustment[] @relation("AdjustmentCreatedBy")
  approvedAdjustments    InventoryAdjustment[] @relation("AdjustmentApprovedBy")
  createdTransfers       WarehouseTransfer[]   @relation("TransferCreatedBy")
  createdPurchaseOrders  PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  approvedPurchaseOrders PurchaseOrder[]       @relation("PurchaseOrderApprovedBy")
  receivedGoodsReceipts  GoodsReceipt[]        @relation("GoodsReceiptReceivedBy")
  createdSalesOrders     SalesOrder[]          @relation("SalesOrderCreatedBy")
  auditLogs              AuditLog[]

  @@index([status, role])
  @@map("users")
}

model Customer {
  id          String            @id @default(cuid())
  firstName   String
  lastName    String
  email       String            @unique
  phone       String?
  status      CustomerStatus    @default(ACTIVE)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)
  addresses   CustomerAddress[]
  salesOrders SalesOrder[]
  returns     Return[]

  @@index([status])
  @@map("customers")
}

model CustomerAddress {
  id            String       @id @default(cuid())
  customerId    String
  label         AddressLabel @default(OTHER)
  recipientName String
  phone         String?
  line1         String
  line2         String?
  city          String
  state         String
  postalCode    String
  country       String       @default("IN")
  isDefault     Boolean      @default(false)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrders   SalesOrder[] @relation("SalesOrderShippingAddress")

  @@index([customerId])
  @@map("customer_addresses")
}

model ProductCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  parentId    String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    ProductCategory[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id                 String                    @id @default(cuid())
  sku                String                    @unique
  name               String
  description        String?
  categoryId         String
  unitPrice          Int                       @default(0)
  productStatus      ProductStatus             @default(ACTIVE)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(6)
  category           ProductCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryBalances  InventoryBalance[]
  stockMovements     StockMovement[]
  reservations       Reservation[]
  adjustmentItems    InventoryAdjustmentItem[]
  transferItems      WarehouseTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]

  @@index([categoryId])
  @@index([productStatus])
  @@map("products")
}

model Warehouse {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postalCode           String?
  country              String                @default("IN")
  status               WarehouseStatus       @default(ACTIVE)
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)
  inventoryBalances    InventoryBalance[]
  stockMovements       StockMovement[]
  reservations         Reservation[]
  adjustments          InventoryAdjustment[]
  sourceTransfers      WarehouseTransfer[]   @relation("TransferSourceWarehouse")
  destinationTransfers WarehouseTransfer[]   @relation("TransferDestinationWarehouse")
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  shipments            Shipment[]
  returnItemsToRestock ReturnItem[]          @relation("ReturnItemRestockWarehouse")

  @@index([status])
  @@map("warehouses")
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  address        String?
  status         SupplierStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@map("suppliers")
}

model InventoryBalance {
  id               String    @id @default(cuid())
  productId        String
  warehouseId      String
  onHandQuantity   Int       @default(0)
  reservedQuantity Int       @default(0)
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_balances")
}

model StockMovement {
  id                 String                   @id @default(cuid())
  productId          String
  warehouseId        String
  movementType       StockMovementType
  quantityDelta      Int
  unitCost           Int?
  notes              String?
  goodsReceiptItemId String?
  shipmentItemId     String?
  transferItemId     String?
  adjustmentItemId   String?
  returnItemId       String?
  createdById        String?
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  product            Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse          Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy          User?                    @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  goodsReceiptItem   GoodsReceiptItem?        @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  shipmentItem       ShipmentItem?            @relation(fields: [shipmentItemId], references: [id], onDelete: Restrict)
  transferItem       WarehouseTransferItem?   @relation(fields: [transferItemId], references: [id], onDelete: Restrict)
  adjustmentItem     InventoryAdjustmentItem? @relation(fields: [adjustmentItemId], references: [id], onDelete: Restrict)
  returnItem         ReturnItem?              @relation(fields: [returnItemId], references: [id], onDelete: Restrict)

  @@index([productId, warehouseId, createdAt])
  @@index([movementType, createdAt])
  @@map("stock_movements")
}

model Reservation {
  id               String            @id @default(cuid())
  salesOrderItemId String
  productId        String
  warehouseId      String
  quantity         Int
  quantityConsumed Int               @default(0)
  quantityReleased Int               @default(0)
  status           ReservationStatus @default(ACTIVE)
  expiresAt        DateTime?         @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  salesOrderItem   SalesOrderItem    @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([salesOrderItemId, warehouseId])
  @@map("reservations")
}

model InventoryAdjustment {
  id             String                    @id @default(cuid())
  adjustmentNo   String                    @unique
  warehouseId    String
  status         InventoryAdjustmentStatus @default(DRAFT)
  reason         String
  notes          String?
  createdById    String
  approvedById   String?
  idempotencyKey String                    @unique
  createdAt      DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(6)
  warehouse      Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy      User                      @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy     User?                     @relation("AdjustmentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  items          InventoryAdjustmentItem[]

  @@index([warehouseId, status])
  @@map("inventory_adjustments")
}

model InventoryAdjustmentItem {
  id             String              @id @default(cuid())
  adjustmentId   String
  productId      String
  quantityDelta  Int
  reason         String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  adjustment     InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@unique([adjustmentId, productId])
  @@index([productId])
  @@map("inventory_adjustment_items")
}

model WarehouseTransfer {
  id                     String                  @id @default(cuid())
  transferNo             String                  @unique
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 WarehouseTransferStatus @default(DRAFT)
  notes                  String?
  createdById            String
  idempotencyKey         String                  @unique
  requestedAt            DateTime                @default(now()) @db.Timestamptz(6)
  dispatchedAt           DateTime?               @db.Timestamptz(6)
  receivedAt             DateTime?               @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  sourceWarehouse        Warehouse               @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse               @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items                  WarehouseTransferItem[]

  @@index([sourceWarehouseId, status])
  @@index([destinationWarehouseId, status])
  @@map("warehouse_transfers")
}

model WarehouseTransferItem {
  id                 String            @id @default(cuid())
  transferId         String
  productId          String
  quantityRequested  Int
  quantityDispatched Int               @default(0)
  quantityReceived   Int               @default(0)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)
  transfer           WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product            Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements     StockMovement[]

  @@unique([transferId, productId])
  @@index([productId])
  @@map("warehouse_transfer_items")
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  purchaseOrderNo String              @unique
  supplierId      String
  warehouseId     String
  status          PurchaseOrderStatus @default(DRAFT)
  currency        String              @default("INR")
  subtotal        Int                 @default(0)
  discountAmount  Int                 @default(0)
  shippingAmount  Int                 @default(0)
  totalAmount     Int                 @default(0)
  notes           String?
  createdById     String
  approvedById    String?
  orderedAt       DateTime?           @db.Timestamptz(6)
  expectedAt      DateTime?           @db.Timestamptz(6)
  idempotencyKey  String?             @unique
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse       Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy       User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy      User?               @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]

  @@index([supplierId, status])
  @@index([warehouseId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String             @id @default(cuid())
  purchaseOrderId   String
  productId         String
  orderedQuantity   Int
  receivedQuantity  Int                @default(0)
  unitCost          Int
  discountAmount    Int                @default(0)
  lineTotal         Int
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceiptItems GoodsReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  receiptNo       String             @unique
  purchaseOrderId String
  warehouseId     String
  status          GoodsReceiptStatus @default(DRAFT)
  receivedById    String
  notes           String?
  receivedAt      DateTime           @default(now()) @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy      User               @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId, status])
  @@index([warehouseId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  quantityReceived    Int
  quantityAccepted    Int
  quantityRejected    Int               @default(0)
  unitCost            Int?
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  stockMovements      StockMovement[]

  @@unique([goodsReceiptId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@map("goods_receipt_items")
}

model SalesOrder {
  id                    String            @id @default(cuid())
  orderNo               String            @unique
  customerId            String
  status                SalesOrderStatus  @default(DRAFT)
  paymentStatus         PaymentStatus     @default(PENDING)
  fulfillmentStatus     FulfillmentStatus @default(UNFULFILLED)
  shippingAddressId     String?
  shippingRecipientName String?
  shippingPhone         String?
  shippingLine1         String?
  shippingLine2         String?
  shippingCity          String?
  shippingState         String?
  shippingPostalCode    String?
  shippingCountry       String?
  subtotal              Int               @default(0)
  discountAmount        Int               @default(0)
  shippingAmount        Int               @default(0)
  totalAmount           Int               @default(0)
  currency              String            @default("INR")
  notes                 String?
  cancellationReason    String?
  idempotencyKey        String            @unique
  createdById           String
  orderedAt             DateTime?         @db.Timestamptz(6)
  cancelledAt           DateTime?         @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(6)
  customer              Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingAddress       CustomerAddress?  @relation("SalesOrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  createdBy             User              @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items                 SalesOrderItem[]
  shipments             Shipment[]
  payments              Payment[]
  returns               Return[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                  String         @id @default(cuid())
  salesOrderId        String
  productId           String
  productNameSnapshot String
  skuSnapshot         String
  quantity            Int
  unitPrice           Int
  discountAmount      Int            @default(0)
  lineTotal           Int
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)
  salesOrder          SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservations        Reservation[]
  shipmentItems       ShipmentItem[]
  returnItems         ReturnItem[]

  @@unique([salesOrderId, productId])
  @@index([productId])
  @@map("sales_order_items")
}

model Shipment {
  id             String         @id @default(cuid())
  shipmentNo     String         @unique
  salesOrderId   String
  warehouseId    String
  status         ShipmentStatus @default(DRAFT)
  trackingNumber String?
  carrier        String?
  notes          String?
  dispatchedAt   DateTime?      @db.Timestamptz(6)
  deliveredAt    DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  salesOrder     SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items          ShipmentItem[]

  @@index([salesOrderId, status])
  @@index([warehouseId, status])
  @@map("shipments")
}

model ShipmentItem {
  id               String          @id @default(cuid())
  shipmentId       String
  salesOrderItemId String
  quantity         Int
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  shipment         Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  salesOrderItem   SalesOrderItem  @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  stockMovements   StockMovement[]

  @@unique([shipmentId, salesOrderItemId])
  @@index([salesOrderItemId])
  @@map("shipment_items")
}

model Payment {
  id                String                @id @default(cuid())
  salesOrderId      String
  provider          String
  providerReference String?
  amount            Int
  currency          String                @default("INR")
  paymentStatus     PaymentStatus         @default(PENDING)
  idempotencyKey    String                @unique
  metadata          Json?
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)
  salesOrder        SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  refunds           Refund[]
  webhookEvents     PaymentWebhookEvent[]

  @@unique([provider, providerReference])
  @@index([salesOrderId, paymentStatus])
  @@map("payments")
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  returnId          String?
  providerReference String?
  amount            Int
  currency          String       @default("INR")
  status            RefundStatus @default(PENDING)
  idempotencyKey    String       @unique
  reason            String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  return            Return?      @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@index([paymentId, status])
  @@index([returnId])
  @@map("refunds")
}

model PaymentWebhookEvent {
  id               String                  @id @default(cuid())
  provider         String
  providerEventId  String
  paymentId        String?
  eventType        String
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  payload          Json
  errorMessage     String?
  receivedAt       DateTime                @default(now()) @db.Timestamptz(6)
  processedAt      DateTime?               @db.Timestamptz(6)
  payment          Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([processingStatus, receivedAt])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

model Return {
  id           String       @id @default(cuid())
  returnNo     String       @unique
  salesOrderId String
  customerId   String
  status       ReturnStatus @default(REQUESTED)
  reason       String?
  notes        String?
  requestedAt  DateTime     @default(now()) @db.Timestamptz(6)
  receivedAt   DateTime?    @db.Timestamptz(6)
  completedAt  DateTime?    @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  salesOrder   SalesOrder   @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        ReturnItem[]
  refunds      Refund[]

  @@index([salesOrderId, status])
  @@index([customerId, createdAt])
  @@map("returns")
}

model ReturnItem {
  id                 String             @id @default(cuid())
  returnId           String
  salesOrderItemId   String
  quantityRequested  Int
  quantityReceived   Int                @default(0)
  inspectionStatus   InspectionStatus   @default(PENDING)
  quantityRestocked  Int                @default(0)
  disposition        ReturnDisposition?
  restockWarehouseId String?
  notes              String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  return             Return             @relation(fields: [returnId], references: [id], onDelete: Restrict)
  salesOrderItem     SalesOrderItem     @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  restockWarehouse   Warehouse?         @relation("ReturnItemRestockWarehouse", fields: [restockWarehouseId], references: [id], onDelete: Restrict)
  stockMovements     StockMovement[]

  @@unique([returnId, salesOrderItemId])
  @@index([salesOrderItemId])
  @@index([restockWarehouseId])
  @@map("return_items")
}

model IdempotencyRecord {
  id             String                  @id @default(cuid())
  scope          IdempotencyScope
  idempotencyKey String
  resourceType   IdempotentResourceType  @default(OTHER)
  resourceId     String?
  status         IdempotencyRecordStatus @default(PROCESSING)
  requestHash    String?
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime?               @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(6)

  @@unique([scope, idempotencyKey])
  @@index([status, expiresAt])
  @@map("idempotency_records")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
